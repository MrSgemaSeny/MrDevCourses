# MrDevCourses Environment Variables Template
# Copy this file to .env for local development:
# cp .env.example .env

# Security / JWT (Required in production, 64-byte hex or base64 string)
JWT_SECRET=your_jwt_secret_64_character_hex_string_here
JWT_EXPIRATION_MS=604800000
JWT_REMEMBER_ME_EXPIRATION_MS=2592000000
JWT_COOKIE_NAME=MrDev_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# Server & Database
PORT=8080
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/mrdev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# CORS & Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Telegram Bot (Optional for dev)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=MrDevelopersbot
TELEGRAM_CHAT_ID=
TELEGRAM_POLLING_ENABLED=false

# Google OAuth2 (Optional for dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
